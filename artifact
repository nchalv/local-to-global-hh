#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: ./artifact <command>

Commands:
  check          Verify the local toolchain and Python dependencies.
  build          Build the evaluator in release mode.
  test           Build and run the C++ and Python unit tests.
  smoke          Run a small bundled end-to-end validation.
  prepare-caida  Stage normalized CAIDA-A and CAIDA-B window counts.
  help           Show this message.

See docs/REPRODUCIBILITY.md and docs/EXPERIMENTS.md before running the
CAIDA-dependent commands.
EOF
}

command="${1:-help}"
shift || true

case "${command}" in
  check)
    exec "${ROOT}/scripts/check_environment.sh" "$@"
    ;;
  build)
    exec "${ROOT}/scripts/build.sh" "$@"
    ;;
  test)
    exec "${ROOT}/scripts/test.sh" "$@"
    ;;
  smoke)
    exec "${ROOT}/scripts/run_smoke.sh" "$@"
    ;;
  prepare-caida)
    exec "${ROOT}/scripts/prepare_caida.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'unknown command: %s\n\n' "${command}" >&2
    usage >&2
    exit 2
    ;;
esac
